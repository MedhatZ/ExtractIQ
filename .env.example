# Shared sample configuration. Copy into each service directory as needed.
# Never commit a real API key.

# --- Python extractor (extractor/.env) ---
MOCK_AI=true
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
FETCH_TIMEOUT_SECONDS=10
OPENAI_TIMEOUT_SECONDS=60
ALLOWED_CONTENT_MAX_BYTES=500000
MAX_TEXT_CHARS=12000
HOST=127.0.0.1
PORT=8000

# --- Node API (api/.env) ---
API_PORT=3001
PYTHON_EXTRACTOR_URL=http://127.0.0.1:8000
EXTRACTOR_TIMEOUT_MS=90000

# --- Next.js UI (web/.env.local) ---
NODE_API_URL=http://127.0.0.1:3001
